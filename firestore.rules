rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      // Siapa saja boleh melihat
      allow read: if true;

      // Hanya pemilik yang boleh menambah, mengubah, menghapus.
      // Ganti GANTI_DENGAN_UID_KAMU dengan UID akun Google kamu.
      allow create, update: if request.auth != null
        && request.auth.uid == 'GANTI_DENGAN_UID_KAMU'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && (!('coverData' in request.resource.data)
            || request.resource.data.coverData.size() <= 150000)
        && (!('price' in request.resource.data)
            || request.resource.data.price == null
            || (request.resource.data.price is int
                && request.resource.data.price >= 0
                && request.resource.data.price <= 100000000000));

      allow delete: if request.auth != null
        && request.auth.uid == 'GANTI_DENGAN_UID_KAMU';
    }

    match /categories/{catId} {
      // Siapa saja boleh membaca daftar kategori
      allow read: if true;

      // Hanya pemilik yang boleh mengelola kategori
      allow create, update: if request.auth != null
        && request.auth.uid == 'GANTI_DENGAN_UID_KAMU'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      allow delete: if request.auth != null
        && request.auth.uid == 'GANTI_DENGAN_UID_KAMU';
    }

    match /figures/{figureId} {
      // Siapa saja boleh melihat koleksi figure
      allow read: if true;

      // Hanya pemilik yang boleh menambah dan mengubah figure
      allow create, update: if request.auth != null
        && request.auth.uid == 'GANTI_DENGAN_UID_KAMU'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.size in ['besar', 'medium', 'kecil']
        && (!('anime' in request.resource.data)
            || (request.resource.data.anime is string && request.resource.data.anime.size() <= 100))
        && (!('photoData' in request.resource.data)
            || request.resource.data.photoData.size() <= 150000)
        && (!('price' in request.resource.data)
            || request.resource.data.price == null
            || (request.resource.data.price is int
                && request.resource.data.price >= 0
                && request.resource.data.price <= 100000000000));

      allow delete: if request.auth != null
        && request.auth.uid == 'GANTI_DENGAN_UID_KAMU';
    }
  }
}
